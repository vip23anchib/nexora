# ==========================================
# Nexora Platform - Environment Configuration
# ==========================================

# Django Core Settings
SECRET_KEY=nexora-insecure-development-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL by default; falls back to SQLite for isolated development if credentials not provided)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=nexora_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# File Upload Limits
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
